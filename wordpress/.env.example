# Kopie als .env anlegen (macht scripts/pawline.ps1 automatisch und erzeugt Zufallspasswörter).
# .env NIEMALS ins Repository einchecken.
WP_PORT=8080
MAILPIT_PORT=8025
DB_PASSWORD=
DB_ROOT_PASSWORD=
WP_ADMIN_USER=pawline-admin
WP_ADMIN_PASSWORD=
# Nur lokale Test-Adresse; Mails landen in Mailpit, nicht im echten Postfach.
WP_ADMIN_EMAIL=admin@pawline.test
