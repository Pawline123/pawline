{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Creme (Hintergrund)", "color": "#FAF6EF" },
				{ "slug": "sand", "name": "Sand", "color": "#EFE6D8" },
				{ "slug": "stone", "name": "Stein", "color": "#D9CDBB" },
				{ "slug": "moss", "name": "Moos (Akzent)", "color": "#5F7350" },
				{ "slug": "moss-dark", "name": "Moos dunkel", "color": "#46573B" },
				{ "slug": "clay", "name": "Ton (Hervorhebung)", "color": "#B5654A" },
				{ "slug": "bark", "name": "Rinde", "color": "#5B4636" },
				{ "slug": "contrast", "name": "Text", "color": "#2E2A26" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Text (Systemschrift)",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Überschriften (Serif, System)",
					"fontFamily": "Georgia, \"Iowan Old Style\", \"Palatino Linotype\", \"Times New Roman\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Klein", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Groß", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Sehr groß", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Riesig", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 5.5rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Weich", "shadow": "0 6px 24px rgba(46, 42, 38, 0.08)" }
			]
		},
		"custom": {
			"radius": { "small": "6px", "medium": "12px", "large": "20px" }
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.2"
				},
				"color": { "text": "var(--wp--preset--color--bark)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--moss-dark)" },
				":hover": { "color": { "text": "var(--wp--preset--color--clay)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--moss)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" }
				},
				"typography": { "fontWeight": "600" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--moss-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--clay)", "offset": "2px", "style": "solid", "width": "2px" }
				}
			}
		},
		"blocks": {
			"core/image": { "border": { "radius": "var(--wp--custom--radius--medium)" } },
			"core/cover": { "border": { "radius": "var(--wp--custom--radius--large)" } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--stone)" } },
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				}
			},
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Kopfbereich", "area": "header" },
		{ "name": "footer", "title": "Fußbereich", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Seite ohne Titel (breit)", "postTypes": [ "page" ] }
	]
}
